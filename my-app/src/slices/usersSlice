import { createSlice } from "@reduxjs/toolkit"

const initialState = {
    users: [],
    login: null,
    error: null
  };

const usersSlice = createSlice({
    name: 'users',
    initialState,
    reducers: {
        getByEmail: (state, action) => {
            try {
              const user = state.users.find((u) => u.email === action.payload.email);
              if (user && user.password === action.payload.password) {
                state.login = user;
                state.error = null; 
              } else {
                state.login = null;
                state.error = 'Неверный email или пароль';
              }
            } catch (error) {
              state.error = 'Произошла ошибка при попытке входа';
            }
          },
          addUser: (state, action) => {
            state.users = [...state.users, action.payload];
            state.error = null; 
          },
          clearError: (state) => {
            state.error = null;
          },
    }
});

export const { getByEmail, addUser, clearError } = usersSlice.actions;
export default usersSlice.reducer;